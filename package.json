{
  "name": "libmssdk",
  "version": "0.1.0",
  "private": true,
  "description": "汽水音乐（Soda Music）应用签名服务：把官方客户端的 bdms.node 封装成 HTTP / stdio 服务，供 libresoda 等第三方客户端调用",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sodahub-org/libmssdk.git"
  },
  "homepage": "https://github.com/sodahub-org/libmssdk#readme",
  "bugs": {
    "url": "https://github.com/sodahub-org/libmssdk/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "libmssdk": "./src/index.mjs"
  },
  "main": "./src/index.mjs",
  "scripts": {
    "start": "node src/index.mjs serve",
    "bridge": "node src/index.mjs bridge",
    "selftest": "node src/index.mjs selftest",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "qishui",
    "soda-music",
    "douyin",
    "mssdk",
    "bdms",
    "x-helios",
    "x-medusa",
    "libresoda"
  ],
  "files": [
    "src",
    "docs",
    "deploy",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ]
}
